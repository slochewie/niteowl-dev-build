    "lucide-react": "latest",
    "postcss": "^8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "latest",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.0.0",
